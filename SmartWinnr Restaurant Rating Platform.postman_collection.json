{
  "info": {
    "_postman_id": "a9d72491-9e23-4581-9b19-smartwinnr2026",
    "name": "SmartWinnr Restaurant Rating Platform",
    "description": "Comprehensive API collection for the SmartWinnr Restaurant Rating & Review Platform covering Customer, Restaurant Owner, and Administrator workflows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "ownerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "restaurantId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reviewId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Customer Registration (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Diner\",\n  \"email\": \"test.diner@smartwinnr.com\",\n  \"password\": \"Customer@12345\",\n  \"confirmPassword\": \"Customer@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new customer. Security: Strictly enforces CUSTOMER role even if client passes elevated role."
          }
        },
        {
          "name": "Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('customerToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya.customer@smartwinnr.com\",\n  \"password\": \"Customer@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates as customer and auto-saves token to customerToken variable."
          }
        },
        {
          "name": "Restaurant Owner Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('ownerToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner.spice@smartwinnr.com\",\n  \"password\": \"Owner@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates as restaurant owner and auto-saves token to ownerToken variable."
          }
        },
        {
          "name": "Administrator Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('adminToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@smartwinnr.com\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates as administrator and auto-saves token to adminToken variable."
          }
        },
        {
          "name": "Get Current User Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Restaurants",
      "item": [
        {
          "name": "Get All Restaurants (Search & Filters)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.restaurants && res.restaurants.length > 0) {",
                  "    pm.collectionVariables.set('restaurantId', res.restaurants[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/restaurants?search=&location=Hyderabad&cuisine=Indian&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "location", "value": "Hyderabad" },
                { "key": "cuisine", "value": "Indian" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Demonstrates combined search, location filter, cuisine filter, and customer review enrichment."
          }
        },
        {
          "name": "Get Restaurant Details by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}"]
            },
            "description": "Retrieves restaurant details, aggregated average rating, total reviews, and full 5-star rating distribution."
          }
        },
        {
          "name": "Get Restaurant Reviews",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}", "reviews"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Customer & Reviews",
      "item": [
        {
          "name": "Submit Review (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.review && res.review._id) {",
                  "    pm.collectionVariables.set('reviewId', res.review._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"content\": \"Sensational dining experience! The flavors, textures, and courteous service exceeded our expectations.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}", "reviews"]
            },
            "description": "Submits a review. Rating must be integer 1-5."
          }
        },
        {
          "name": "Submit Duplicate Review (Expected 409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4,\n  \"content\": \"Attempting to submit a second review for the same restaurant.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}", "reviews"]
            },
            "description": "Demonstrates database compound unique index constraint enforcement. Expected HTTP 409 Conflict: 'You have already reviewed this restaurant.'"
          }
        },
        {
          "name": "Get My Submitted Reviews",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reviews/me",
              "host": ["{{baseUrl}}"],
              "path": ["reviews", "me"]
            }
          }
        },
        {
          "name": "Update Customer Review",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"content\": \"Updated review: Chef personally visited our table and the dessert was perfection.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reviews/{{reviewId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reviews", "{{reviewId}}"]
            }
          }
        },
        {
          "name": "Delete Customer Review",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reviews/{{reviewId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reviews", "{{reviewId}}"]
            }
          }
        }
      ]
    },
